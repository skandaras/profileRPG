# Where the SQLite database lives
DATA_DIR=./data

# Public URL of this instance. Required behind a reverse proxy, or SvelteKit's
# CSRF check rejects every form submission.
ORIGIN=http://localhost:5173

# authelia | dev
#   authelia: identity comes from Remote-User/Remote-Name/Remote-Email/Remote-Groups,
#             accepted only when the request's peer address is in TRUSTED_PROXY_IPS
#   dev:      every request is DEV_USER, and /dev/skip?hours=N moves the game clock
AUTH_MODE=dev
DEV_USER=dev

# Comma-separated IPs or IPv4 CIDRs allowed to supply identity headers (the reverse proxy)
TRUSTED_PROXY_IPS=127.0.0.1,::1

# If set, signed-in users outside this Authelia group get a 403
ALLOWED_GROUP=
